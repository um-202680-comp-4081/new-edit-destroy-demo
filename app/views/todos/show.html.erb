<h1><%= @todo.title %></h1>

<p>
  Due: <%= @todo.due_date.strftime('%m/%d/%Y') %>
</p>

<p>
  <%= @todo.description %>
</p>

<p class="d-flex align-items-left">
  <%= link_to 'Edit', edit_todo_path, class: 'btn btn-sm btn-primary' %>
  <%= button_to 'Delete', todo_path(@todo), method: :delete, data: { turbo: false }, class: 'btn btn-sm btn-danger' %>
</p>
